{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Chrome - Port 3000)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=3000"
      ]
    },
    {
      "name": "Flutter Web Server (Port 3000)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": [
        "--web-port=3000",
        "--web-hostname=localhost"
      ]
    },
    {
      "name": "Flutter Web Release (Port 3000)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=3000"
      ]
    }
  ]
}
